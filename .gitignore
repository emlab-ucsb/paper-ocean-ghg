# History files
.Rhistory
.Rapp.history
# Session Data files
.RData
.RDataTmp
# User-specific files
.Ruserdata
# Example code in package build process
*-Ex.R
# Output files from R CMD build
/*.tar.gz
# Output files from R CMD check
/*.Rcheck/
# RStudio files
.Rproj.user/
# produced vignettes
vignettes/*.html
vignettes/*.pdf
# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth
# knitr and R markdown default cache directories
*_cache/
/cache/
# Temporary files created by R markdown
*.utf8.md
*.knit.md
# Quarto writes this intermediate next to the .qmd and deletes it after each
# render, so tracking it churns the diff and flips it in and out of the tree
*.rmarkdown
# R Environment Variables
.Renviron
# pkgdown site
docs/
# translation temp files
po/*~
# RStudio Connect folder
rsconnect/
paper-ocean-ghg.Rproj
*.Rproj
# Don't save quarto cache - it gets big
qmd/quarto_notebook_cache/
qmd/quarto_notebook_cache/*

*.zip
# macOS Finder metadata
.DS_Store

# Rendered notebook PDF. main.tex does not reference it and Overleaf compiles
# its own PDF, so tracking it only pushed ~18 MB of wholesale-rewritten binary
# through the Overleaf sync on every render. Still written locally by pipeline 03.
qmd/quarto_notebook.pdf
