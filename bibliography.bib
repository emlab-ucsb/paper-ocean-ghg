  title = {Global Assessment of Shipping Emissions in 2015 on a High Spatial and Temporal Resolution},
  author = {Johansson, Lasse and Jalkanen, Jukka-Pekka and Kukkonen, Jaakko},
  year = 2017,
  month = oct,
  journal = {Atmospheric Environment},
